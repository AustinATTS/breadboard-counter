<templates xml:space="preserve">
    <t t-name="breadboard.counter.app">
        <div class="breadboard_counter_app">
            <div class="breadboard_counter_topbar">
                <button class="btn" t-on-click="this.reset">
                    Reset
                </button>
                <button class="btn primary" t-on-click="this.openSettings">
                    Settings
                </button>
                <button class="btn danger" t-on-click="this.fullReset">
                    Full Reset
                </button>
            </div>
            <div class="breadboard_counter_main">
                <button class="circle-btn left" t-on-click="this.decrement">
                    -
                </button>
                <div class="breadboard_counter_value">
                    <t t-out="this.state.counter.value"/>
                </div>
                <button class="circle-btn right" t-on-click="this.increment">
                    +
                </button>
            </div>
            <t t-if="this.state.showSettings">
                <div class="overlay" t-on-click="this.closeSettings">
                    <div class="dialog" t-on-click.stop="">
                        <h2>
                            Settings
                        </h2>
                        <label>
                            Min
                            <input type="number" placeholder="No minimum"
                                   t-att-value="this.state.counter.minimum"
                                   t-on-input="(event) => this.setMinimum(event.target.value)"/>
                        </label>
                        <label>
                            Max
                            <input type="number" placeholder="No maximum"
                                   t-att-value="this.state.counter.maximum"
                                   t-on-input="(event) => this.setMaximum(event.target.value)"/>
                        </label>

                        <label>
                            Step
                            <input type="number" placeholder="1"
                                   t-att-value="this.state.counter.step"
                                   t-on-input="(event) => this.setStep(event.target.value)"/>
                        </label>

                        <label>
                            Current Value
                            <input type="number" placeholder="0"
                                   t-att-value="this.state.counter.value"
                                   t-on-input="(event) => this.setValue(event.target.value)"/>
                        </label>
                        <button class="btn" t-on-click="this.closeSettings">
                            Close
                        </button>
                    </div>
                </div>
            </t>
        </div>
    </t>
</templates>